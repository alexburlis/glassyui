diff --git a/lib/guard.js b/lib/guard.js
new file mode 100644
index 0000000000000000000000000000000000000000..5c1310de3221df1c67e9a0b5f415dd8a43a500fc
--- /dev/null
+++ b/lib/guard.js
@@ -0,0 +1,47 @@
+'use strict';
+
+const MAX_NESTING = 100;
+const MAX_AST_DEPTH = MAX_NESTING + 1;
+
+const isObject = value =>
+  value !== null && (typeof value === 'object' || typeof value === 'function');
+
+const assertSafeAst = ast => {
+  const active = new WeakSet();
+  const stack = [{ node: ast, depth: 0, exit: false }];
+
+  while (stack.length > 0) {
+    const frame = stack.pop();
+    const { node, depth, exit } = frame;
+
+    if (!isObject(node)) {
+      continue;
+    }
+
+    if (exit) {
+      active.delete(node);
+      continue;
+    }
+
+    if (active.has(node)) {
+      throw new SyntaxError('AST contains a cycle');
+    }
+
+    if (depth > MAX_AST_DEPTH) {
+      throw new SyntaxError(`AST nesting exceeds the maximum of ${MAX_NESTING}`);
+    }
+
+    const children = node.nodes;
+    if (!Array.isArray(children) || children.length === 0) {
+      continue;
+    }
+
+    active.add(node);
+    stack.push({ node, depth, exit: true });
+    for (let index = children.length - 1; index >= 0; index -= 1) {
+      stack.push({ node: children[index], depth: depth + 1, exit: false });
+    }
+  }
+};
+
+module.exports = assertSafeAst;
