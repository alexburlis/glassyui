    "cmdk": "^1.1.1",
    "next": "16.3.8",
    "posthog-js": "1.434.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.529",
    "server-only": "0.0.1",
    "turndown": "7.2.4",
    "mdx-blog-kit": "file:vendor/mdx-blog-kit-0.1.2.tgz",
    "next-mdx-remote": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@oxlint/plugins": "1.83.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "5.0.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "knip": "6.39.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.83.0",
    "playwright": "^1.61.1",
    "shadcn": "4.14.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "source-map-js": "1.2.2",
      "@modelcontextprotocol/sdk": "1.31.0",
      "proxy-addr": "2.0.8",
      "postcss-selector-parser": "7.1.6"
    },
    "patchedDependencies": {
      "next@16.3.8": "patches/next@16.3.8.patch",
      "braces@3.0.3": "patches/braces@3.0.3.patch",
      "mdx-blog-kit@0.1.2": "patches/mdx-blog-kit@0.1.2.patch"
