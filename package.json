    "check:refraction-visuals": "node scripts/check-refraction-visuals.mjs",
    "check:glass-material": "node scripts/check-glass-material.mjs",
    "check:glass-scene": "node scripts/check-glass-scene.mjs",
    "check:site-motion": "node scripts/check-site-motion.mjs",
    "check:keynote": "node scripts/check-keynote.mjs",
    "check:text-selection": "node scripts/check-text-selection.mjs",
