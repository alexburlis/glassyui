{
  "name": "glassy-ui",
  "version": "0.1.0",
  "description": "Copy-ready glass components distributed through a shadcn-compatible source registry.",
  "homepage": "https://glassyui.com",
  "keywords": [
    "glass",
    "glassmorphism",
    "react",
    "shadcn",
    "registry",
    "components",
    "tailwindcss",
    "ui"
  ],
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexburlis/glassyui.git"
  },
  "bugs": {
    "url": "https://github.com/alexburlis/glassyui/issues"
  },
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test:analytics-consent": "node scripts/test-analytics-consent.mjs",
