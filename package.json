    "smoke:release-ui": "node scripts/smoke-release-ui.mjs",
    "lint:anti-slop": "oxlint --deny-warnings --format=agent",
    "smoke:launch": "node scripts/smoke-launch.mjs",
    "format:check": "oxfmt --check",
    "test:error-reports": "node scripts/test-server-error-reports.mjs",
    "test:error-startup": "node scripts/test-error-startup.mjs",
    "test:build-upload": "node scripts/test-build-upload.mjs",
    "test:braces-security": "node scripts/test-braces-security.mjs",
