# Public project token only (phc_...), never a personal/admin API key.
# Runtime settings: missing/invalid values keep optional analytics disabled.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com
# Runtime-only. Enable only behind the reviewed Traefik ingress described in
# docs/analytics-consent.md. Missing/false keeps every regional default opt-in.
ANALYTICS_TRUST_CLOUDFLARE_PROXY=false

# Public routing config for the dedicated glassyui project in https://de.sentry.io.
# Configure at build and runtime. Error reports have a separate opt-in browser choice.
NEXT_PUBLIC_SENTRY_DSN=
# Full Git commit, supplied automatically by Coolify. Release: glassyui@<40-hex commit>.
SOURCE_COMMIT=
# SENTRY_AUTH_TOKEN: supply through a build-only secret or an optional .1p overlay.
# Never put an authentication token in this file or NEXT_PUBLIC_*.
