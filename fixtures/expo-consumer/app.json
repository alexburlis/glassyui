{
  "expo": {
    "name": "Glassy UI",
    "slug": "glassyui-expo-consumer",
    "version": "1.0.0",
    "platforms": ["ios", "android", "web"],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.glassyui.expoconsumer",
      "supportsTablet": true
    },
    "android": {
      "package": "com.glassyui.expoconsumer"
    },
    "plugins": [["expo-build-properties", { "ios": { "enableSceneSupport": true } }]]
  }
}
